# linkwarden-obsidian-sync configuration.
#
# Every setting here can also be set via the environment variable named in
# its comment, which overrides whatever's in this file — the environment
# is how the Docker image is configured, since mounting this file in isn't
# usually worth it there.

# Required. Your Linkwarden instance's base URL, no trailing slash.
# Env: LINKWARDEN_URL
linkwarden_url = ""

# Required. A Linkwarden access token: Settings -> Access Tokens.
# Env: LINKWARDEN_TOKEN
linkwarden_token = ""

# Path to your Obsidian vault (or wherever the notes should live).
# Env: VAULT_PATH
# Default: ~/Documents/obsidian
# vault_path = ""

# Subdirectory of the vault to write notes into.
# Env: VAULT_SUBDIR
# Default: Linkwarden
# vault_subdir = ""

# Where the known-links marker is kept.
# Env: LINKWARDEN_SYNC_STATE_DIR
# Default: $XDG_STATE_HOME/linkwarden-obsidian-sync
# (~/.local/state/linkwarden-obsidian-sync if $XDG_STATE_HOME is unset)
# state_dir = ""
